Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 33; 38
    Fixed Frame: camera_init
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid - 1 m
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 100; 105; 115
      Alpha: 0.4
      Plane: XY
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/PointCloud2
      Name: FAST-LIO cloud - height colour
      Enabled: true
      Topic: /cloud_registered
      Queue Size: 2
      Decay Time: 3
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Alpha: 1
      Use Fixed Frame: true
      Value: true
    - Class: rviz/PointCloud2
      Name: EGO inflated obstacles - requires planner
      Enabled: true
      Topic: /drone_0_ego_planner_node/grid_map/occupancy_inflate
      Queue Size: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 150; 50
      Style: Boxes
      Size (m): 0.15
      Alpha: 0.35
      Use Fixed Frame: true
      Value: true
    - Class: rviz/Path
      Name: FAST-LIO path
      Enabled: true
      Topic: /path
      Queue Size: 1
      Buffer Length: 1
      Color: 80; 230; 160
      Alpha: 1
      Line Style: Lines
      Line Width: 0.02
      Value: true
    - Class: rviz/Odometry
      Name: Scan-corrected LIO pose
      Enabled: true
      Topic: /Odometry
      Queue Size: 5
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Axes
        Axes Length: 0.5
        Axes Radius: 0.025
      Value: true
    - Class: rviz/Marker
      Name: EGO planned trajectory
      Enabled: true
      Marker Topic: /drone_0_ego_planner_node/optimal_list
      Queue Size: 10
      Value: true
    - Class: rviz/Marker
      Name: EGO goal
      Enabled: true
      Marker Topic: /drone_0_ego_planner_node/goal_point
      Queue Size: 10
      Value: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1280
  Height: 800
