<launch>
  <!-- Use the project's current EGO launch parameters.
       Upstream FAST-LIO names its registered-cloud frame "camera_init";
       upstream EGO/RViz name the SAME numerical frame "world". This identity
       alias changes neither data nor origin, and does not start the body-frame
       adapter, px4ctrl, MAVROS, or any takeoff/arming command. -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="raw_lio_world_alias" args="0 0 0 0 0 0 1 world camera_init"/>
  <include file="$(find ego_planner)/launch/single_run_in_exp.launch"/>
</launch>
