<launch>
  <!-- Down camera acquisition only. Defaults are the HD USB Camera; another camera passes its
       own format and calibration from the flight/red_point.yaml camera section. -->
  <arg name="video_device" default="/dev/v4l/by-id/usb-HD_Camera_Manufacturer_USB_2.0_Camera-video-index0"/>
  <!-- Let exposure follow the scene; the monitor reports actual capture FPS. -->
  <arg name="autoexposure" default="true"/>
  <arg name="exposure" default="200"/>
  <arg name="image_width" default="1280"/>
  <arg name="image_height" default="720"/>
  <arg name="pixel_format" default="yuyv"/>
  <arg name="framerate" default="9"/>
  <arg name="camera_name" default="down_hd_1280x720_yuyv"/>
  <arg name="camera_info_url" default="file://$(find airseafly_real400)/config/aircraft/down_hd_1280x720_yuyv_calib.yaml"/>
  <node pkg="usb_cam" type="usb_cam_node" name="down_camera" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="io_method" value="mmap"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="pixel_format" value="$(arg pixel_format)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="autoexposure" type="bool" value="$(arg autoexposure)"/>
    <param name="exposure" type="int" value="$(arg exposure)"/>
    <param name="camera_frame_id" value="down_camera_optical"/>
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
  </node>
</launch>
